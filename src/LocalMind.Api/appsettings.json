{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Literate, Serilog.Sinks.Console",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Urls": "http://localhost:5080",
  "Agent": {
    "ModelName": "qwen3:8b",
    "MaxIterations": 8,
    "MaxOutputRetries": 3
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434"
  },
  "Qdrant": {
    "Host": "localhost",
    "Port": 6334,
    "Https": false,
    "ApiKey": "",
    "GrpcTimeout": "00:01:00"
  },
  "KnowledgeBase": {
    "CollectionName": "knowledge",
    "EmbeddingModel": "nomic-embed-text",
    "VectorSize": 768,
    "DefaultTopK": 5,
    "MaxTopK": 10
  },
  "DocumentIngest": {
    "ChunkSize": 2000,
    "Overlap": 300,
    "EmbeddingBatchSize": 16,
    "UpsertBatchSize": 32,
    "EnableContextualization": true,
    "ContextualizationModel": "qwen2.5:1.5b-instruct",
    "ContextualizationConcurrency": 3
  },
  "SemanticCache": {
    "Enabled": true,
    "CollectionName": "semantic_cache",
    "EmbeddingModel": "nomic-embed-text",
    "VectorSize": 768,
    "SimilarityThreshold": 0.92
  },
  "QueryRewriter": {
    "Model": "qwen3:8b"
  },
  "Metrics": {
    "Port": 9091
  },
  "EntityExtractor": {
    "Model": "qwen2.5:1.5b-instruct"
  },
  "CharacterRoster": {
    "ConnectionString": "Host=localhost;Port=5432;Database=xmen;Username=x-men-user;Password=x-men-password"
  },
  "Tracing": {
    "Enabled": true,
    "OtlpEndpoint": "http://localhost:4317"
  }
}
